+      while true
+        # 0 is below any heap address, so a quad loop that does not run
+        # leaves `w` under `lo`.
+        w = 0_u64
+        while p < quad_end
+          w = p[0]
+          break if w >= lo
+          w = p[1]
+          if w >= lo
+            p += 1
+            break
+          end
+          w = p[2]
+          if w >= lo
+            p += 2
+            break
+          end
+          w = p[3]
+          if w >= lo
+            p += 3
+            break
+          end
+          p += 4
+        end
+        if w < lo
