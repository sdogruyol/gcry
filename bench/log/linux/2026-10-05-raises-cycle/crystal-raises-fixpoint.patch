+    # Callee → callers whose `raises?` was decided while the callee's was
+    # still false. See `propagate_raises`.
+    @raises_callers = Hash(Def, Array(Def)).new.compare_by_identity
+
+    # Propagates `raises?` along every call edge recorded by `transform(Call)`
+    # until nothing changes. `transform(Call)` copies the flag from callee to
+    # caller once, when it reaches the call; a callee whose body is still being
+    # transformed (a call cycle) can only learn later that it raises, and its
+    # callers would otherwise stay marked as not raising, so calls to them get
+    # no landing pad and a surrounding `rescue` never runs.
+    def propagate_raises : Nil
+      pending = @raises_callers.keys.select(&.raises?)
+      while callee = pending.pop?
+        @raises_callers.delete(callee).try &.each do |caller|
+          next if caller.raises?
+          caller.raises = true
+          pending << caller
+        end
+      end
+    end
+
     def inside_def!
       @def_nest_count += 1
     end
