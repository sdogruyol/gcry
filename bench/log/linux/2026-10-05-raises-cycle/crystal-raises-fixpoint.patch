diff --git a/spec/compiler/codegen/exception_spec.cr b/spec/compiler/codegen/exception_spec.cr
index 9e72571..089c414 100644
--- a/spec/compiler/codegen/exception_spec.cr
+++ b/spec/compiler/codegen/exception_spec.cr
@@ -1479,4 +1479,37 @@ describe "Code gen: exception" do
       x
       CRYSTAL
   end
+
+  it "rescues from a method that only raises through a call cycle (#raises? fixpoint)" do
+    run(<<-CRYSTAL).to_i.should eq(2)
+      require "prelude"
+
+      def s3(n)
+        helper(n)
+        raise "boom" if n == 0
+        n
+      end
+
+      def helper(n)
+        s2(n + 1) if n > 100
+      end
+
+      def s2(n)
+        s3(n)
+      end
+
+      # Transforms s3 first: helper and s2 are reached while s3 is still
+      # being transformed and does not yet raise.
+      s3(1)
+
+      x = 0
+      begin
+        s2(0)
+        x = 1
+      rescue
+        x = 2
+      end
+      x
+      CRYSTAL
+  end
 end
