+# A radix entry's low bits carry its chunk's size class and kind
+# (`Heap::RADIX_TAG_MASK`), and the mark's inline candidate path
+# (`Heap#scan_edges_inline`) resolves a tagged candidate from the tag and its
+# class's geometry without reading the chunk header. A tag that disagreed with
+# its chunk would resolve candidates against the wrong class — the wrong
+# block, the wrong `occ` and mark words, an atomic block pushed or a
+# pointerful one never scanned — and nothing would announce it. That path
+# runs only with the world stopped, so these examples pin what it reads: every
+# entry of every chunk, against that chunk's own header.
+describe "chunk radix class tags" do
+  it "tags every size-class bitmap chunk with its class and kind, and its geometry matches" do
+    heap = Gcry::Heap.new
+    begin
+      heap.chunk_radix = true
+      heap.bitmap_alloc = true
+      heap.gc_threshold = UInt64::MAX
+      kept = [] of Void*
+      [16, 48, 100, 512, 2000, 8000].each do |size|
+        200.times do
+          kept << heap.malloc(size.to_u64)
+          kept << heap.malloc_atomic(size.to_u64)
+        end
+      end
+      kept << heap.malloc(1_u64 << 20)
+
+      tagged = 0
+      large = 0
+      kinds = Set(Bool).new
+      heap.each_chunk do |chunk|
+        first = Pointer(Void).new(chunk.address)
+        last = Pointer(Void).new(chunk.address + chunk.value.mapped_bytes - 1)
+        if Gcry::ChunkHeader.large?(chunk)
+          heap.radix_tag_of(first).should eq(0_u64)
+          heap.radix_tag_of(last).should eq(0_u64)
+          large += 1
+          next
+        end
+        cls = chunk.value.size_class
+        atomic = Gcry::ChunkHeader.atomic?(chunk)
+        kinds << atomic
+        expected = (cls.to_u64 + 1) | (atomic ? Gcry::Heap::RADIX_TAG_ATOMIC : 0_u64)
+        # Every granule of the chunk, the first and the last.
+        heap.radix_tag_of(first).should eq(expected)
+        heap.radix_tag_of(last).should eq(expected)
+
+        geom = heap.@radix_class_geom[cls.to_i32]
+        block_bytes = Gcry::BlockHeader::SIZE.to_u64 + Gcry::SizeClasses.payload(cls.to_i32).to_u64
+        (geom & 0xFFFF_u64).should eq(chunk.value.data_offset.to_u64)
+        ((geom >> 16) & 0xFFFF_u64).should eq(chunk.value.bitmap_words.to_u64)
+        (geom >> 32).should eq(Gcry::Heap.chunk_block_count(block_bytes, chunk.value.mapped_bytes, chunk.value.data_offset))
+        tagged += 1
+      end
+      tagged.should be >= 12
+      large.should be > 0
+      kinds.size.should eq(2)
+
+      # And the lookups every other reader makes still name the chunk.
+      kept.each { |ptr| heap.find_block(ptr).should_not be_nil }
+    ensure
+      heap.destroy
+    end
+  end
+
+  # `radix_remove` clears only an entry that still names the chunk, and a
+  # tagged entry is not the bare chunk pointer: compared whole, every tagged
+  # entry would outlive its unmap.
+  it "clears a tagged chunk's entries when the chunk is unmapped" do
+    heap = Gcry::Heap.new
+    begin
+      heap.chunk_radix = true
+      heap.bitmap_alloc = true
+      heap.gc_threshold = UInt64::MAX
+      # Unmap fully free chunks at once; the knobs are `empty_chunk_grace_spec`'s,
+      # for the same reason (another example's thread must not turn the release
+      # path off).
+      heap.release_empty_chunks = true
+      heap.parallel_empty_chunk_dormant = true
+      heap.parallel_empty_chunk_munmap = true
+      heap.empty_chunk_warm_retain = 0_u64
+      heap.empty_chunk_retain = 0_u64
+      200.times { heap.malloc(4096) }
+      bases = [] of UInt64
+      heap.each_chunk { |chunk| bases << chunk.address unless Gcry::ChunkHeader.large?(chunk) }
+      bases.each { |base| heap.radix_tag_of(Pointer(Void).new(base)).should_not eq(0_u64) }
+      # The second major unmaps what the first kept for its grace cycle.
+      2.times { heap.collect(scan_stack: false) }
+      owned = Set(UInt64).new
+      heap.each_chunk { |chunk| owned << chunk.address }
+      released = bases.reject { |base| owned.includes?(base) }
+      released.should_not be_empty
+      released.each { |base| heap.radix_tag_of(Pointer(Void).new(base)).should eq(0_u64) }
+    ensure
+      heap.destroy
+    end
+  end
+end
