+class Gcry::Heap
+  def reg61_audit(target : UInt64) : Nil
+    @address_space_audit = true
+    @address_space_report_limit = 40
+    audit_address_space(target, 16_u64, "reg61 target")
+    audit_address_space(target &- 16_u64, 16_u64, "reg61 target header")
+    @address_space_audit = false
+  end
+
+  def reg61_my_set : UInt64
+    cursor_set_cached.address
+  end
+
+  def reg61_first_block?(user : UInt64) : Bool
+    chunk = chunk_containing(user)
+    return false unless chunk
+    ChunkHeader.data_start(chunk).address &+ BlockHeader::SIZE == user
+  end
+end
+
+module Reg61Diag
+  MASK = 0x5a5a_5a5a_5a5a_5a5a_u64
+  @@masked = 0_u64
+  @@arm_thread = 0_u64
+  @@arm_set = 0_u64
+
+  def self.arm(addr : UInt64) : Nil
+    @@masked = addr ^ MASK
+    marker = ->Reg61Diag.marker
+    @@fn = marker.pointer.address
+    @@arm_thread = Thread.current.object_id
+    @@arm_set = Gcry.default_heap.reg61_my_set
+    Gcry.default_heap.reg61_watch = @@masked
+    heap = Gcry.default_heap
+    heap.live_attr_roots = true
+    heap.live_attr_watch_tid = FreedHolderTarget.crystal_instance_type_id
+    heap.post_stw_hook = ->(stage : Symbol) { Reg61Diag.hook(stage); nil }
+  end
+
+  def self.hook(stage : Symbol) : Nil
+    return unless stage == :before_large_take
+    heap = Gcry.default_heap
+    buf = uninitialized UInt8[512]
+    len = Gcry::RawOut.append(buf.to_unsafe, 0, "REG61 collection ")
+    len = Gcry::RawOut.append_u64(buf.to_unsafe, len, heap.collections)
+    len = Gcry::RawOut.append(buf.to_unsafe, len, " watch stack=")
+    len = Gcry::RawOut.append_u64(buf.to_unsafe, len, heap.first_mark_watch_stack)
+    len = Gcry::RawOut.append(buf.to_unsafe, len, " parked=")
+    len = Gcry::RawOut.append_u64(buf.to_unsafe, len, heap.first_mark_watch_parked)
+    len = Gcry::RawOut.append(buf.to_unsafe, len, " static=")
+    len = Gcry::RawOut.append_u64(buf.to_unsafe, len, heap.first_mark_watch_static)
+    len = Gcry::RawOut.append(buf.to_unsafe, len, " thread=")
+    len = Gcry::RawOut.append_u64(buf.to_unsafe, len, heap.first_mark_watch_thread)
+    len = Gcry::RawOut.append(buf.to_unsafe, len, " precise=")
+    len = Gcry::RawOut.append_u64(buf.to_unsafe, len, heap.first_mark_watch_precise)
+    len = Gcry::RawOut.append(buf.to_unsafe, len, " heap=")
+    len = Gcry::RawOut.append_u64(buf.to_unsafe, len, heap.first_mark_watch_heap)
+    len = Gcry::RawOut.append(buf.to_unsafe, len, " scan=[0x")
+    len = Gcry::RawOut.append_hex(buf.to_unsafe, len, Gcry::Roots.last_mutator_low)
+    len = Gcry::RawOut.append(buf.to_unsafe, len, ",0x")
+    len = Gcry::RawOut.append_hex(buf.to_unsafe, len, Gcry::Roots.last_mutator_high)
+    len = Gcry::RawOut.append(buf.to_unsafe, len, ") entry_sp=0x")
+    len = Gcry::RawOut.append_hex(buf.to_unsafe, len, heap.collect_entry_sp)
+    len = Gcry::RawOut.append(buf.to_unsafe, len, "\n")
+    Gcry::RawOut.flush(buf.to_unsafe, len)
+    slot = heap.reg61_seed_slot
+    if slot != 0
+      heap.reg61_seed_slot = 0
+      len = Gcry::RawOut.append(buf.to_unsafe, 0, "REG61 fn=0x")
+      len = Gcry::RawOut.append_hex(buf.to_unsafe, len, @@fn)
+      len = Gcry::RawOut.append(buf.to_unsafe, len, " slot=0x")
+      len = Gcry::RawOut.append_hex(buf.to_unsafe, len, slot)
+      len = Gcry::RawOut.append(buf.to_unsafe, len, " slot-entry_sp=")
+      len = Gcry::RawOut.append_u64(buf.to_unsafe, len, slot &- heap.collect_entry_sp)
+      len = Gcry::RawOut.append(buf.to_unsafe, len, "\n")
+      Gcry::RawOut.flush(buf.to_unsafe, len)
+      if slot > heap.collect_entry_sp
+        a = slot &- 0x100
+        while a < slot &+ 0x180
+          len = Gcry::RawOut.append(buf.to_unsafe, 0, "REG61 w 0x")
+          len = Gcry::RawOut.append_hex(buf.to_unsafe, len, a)
+          len = Gcry::RawOut.append(buf.to_unsafe, len, " +")
+          len = Gcry::RawOut.append_u64(buf.to_unsafe, len, a &- heap.collect_entry_sp)
+          len = Gcry::RawOut.append(buf.to_unsafe, len, " = 0x")
+          len = Gcry::RawOut.append_hex(buf.to_unsafe, len, Pointer(UInt64).new(a).value)
+          len = Gcry::RawOut.append(buf.to_unsafe, len, a == slot ? " <== seed\n" : "\n")
+          Gcry::RawOut.flush(buf.to_unsafe, len)
+          a &+= 8
+        end
+      end
+    end
+    heap.reg61_audit(@@masked ^ MASK)
+  end
+
+  @@fn = 0_u64
+
+  def self.marker : Nil
+  end
+
+  @[NoInline]
+  def self.verdict(ref : WeakRef(FreedHolderTarget)) : Nil
+    heap = Gcry.default_heap
+    heap.post_stw_hook = nil
+    heap.reg61_watch = 0
+    heap.live_attr_roots = false
+    heap.live_attr_watch_tid = 0
+    alive = ref.@target.address != 0
+    STDERR.puts(alive ? "REG61 VERDICT alive" : "REG61 VERDICT dead")
+    STDERR.puts "REG61 arm thread=0x#{@@arm_thread.to_s(16)} set=0x#{@@arm_set.to_s(16)}; main thread=0x#{Thread.current.object_id.to_s(16)} set=0x#{heap.reg61_my_set.to_s(16)}"
+    STDERR.puts "REG61 fn=0x#{@@fn.to_s(16)}"
+  end
+end
+
