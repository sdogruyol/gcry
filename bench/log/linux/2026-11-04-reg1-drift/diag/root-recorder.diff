diff -r a/src/gcry/collect_mark.cr b/src/gcry/collect_mark.cr
--- a/src/gcry/collect_mark.cr	2026-11-02 18:51:38.000000000 +0300
+++ b/src/gcry/collect_mark.cr	2026-11-02 20:58:10.096008678 +0300
@@ -1,6 +1,30 @@
 # Mark phase: candidates, object scan, nursery remembered-set helpers.
 
 module Gcry
+  {% if flag?(:reg1_diag) %}
+    # Reg1 diagnostic: every root candidate that first-marks a block.
+    module Reg1Diag
+      CAP = 1 << 20
+      class_property on = false
+      class_property recs = Pointer(UInt64).null
+      class_property n = 0
+      class_property dropped = 0
+
+      def self.add(col : UInt64, src : UInt64, slot : UInt64, val : UInt64, hdr : UInt64, chunk : UInt64 = 0_u64) : Nil
+        if @@recs.null?
+          @@recs = LibC.malloc(CAP * 48).as(UInt64*)
+        end
+        i = @@n
+        if i >= CAP
+          @@dropped += 1
+          return
+        end
+        @@n = i + 1
+        r = @@recs + i * 6
+        r[0] = col; r[1] = src; r[2] = slot; r[3] = val; r[4] = hdr; r[5] = chunk
+      end
+    end
+  {% end %}
   class Heap
     # Ambient-root source tag for per-source reject counters. Distinguishes
     # fiber/mutator stacks, BSS/data segments, and TLS (thread) so the
@@ -64,6 +88,15 @@
           end
         end
       {% end %}
+      {% if flag?(:reg1_diag) %}
+        if Reg1Diag.on && (found = find_block_with_chunk(pointer))
+          h, c = found
+          if block_allocated?(c, h) && !block_marked_in?(c, h)
+            Reg1Diag.add(@collections, source.value.to_u64, Roots.hl_slot, pointer.address, h.address, c.address)
+          end
+        end
+        Roots.hl_slot = 0_u64
+      {% end %}
       mark_impl(pointer, gate_type_id: gate, base_only: !@allow_interior_pointers, source: source)
     end
 
@@ -79,6 +112,14 @@
     # @entries / Array @buffer have no Crystal type_id). Interior policy matches
     # ambient roots so allow_interior_pointers still applies.
     private def mark_explicit_root(pointer : Void*) : Nil
+      {% if flag?(:reg1_diag) %}
+        if Reg1Diag.on && (found = find_block_with_chunk(pointer))
+          h, c = found
+          if block_allocated?(c, h) && !block_marked_in?(c, h)
+            Reg1Diag.add(@collections, 99_u64, 0_u64, pointer.address, h.address)
+          end
+        end
+      {% end %}
       mark_impl(pointer, gate_type_id: false, base_only: !@allow_interior_pointers, source: RootSource::Stack)
     end
 
