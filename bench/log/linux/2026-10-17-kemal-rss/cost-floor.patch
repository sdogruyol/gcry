         heap.collect(scan_stack: false)
         # Past half the threshold: a measurable cycle, had pacing been on.
         1536.times { heap.malloc_atomic(4096) }
@@ -230,7 +231,16 @@ describe "adaptive collection threshold" do
 
         heap.threshold_pace_max_pct = 300_u64
         heap.collect(scan_stack: false) # the first paced major has nothing to measure from
-        1536.times { heap.malloc_atomic(4096) }
+        # One measured cycle is not enough: the floor reads the cheaper of
+        # the last two, so a single expensive cycle cannot raise it. Three
+        # quarters of the threshold each time: past the half a measured cycle
+        # needs, short of an automatic collection — and pacing may raise the
