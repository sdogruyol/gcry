diff --git a/src/gcry/os_memory.cr b/src/gcry/os_memory.cr
index fac756e9..5d6f4ea1 100644
--- a/src/gcry/os_memory.cr
+++ b/src/gcry/os_memory.cr
@@ -26,6 +26,15 @@ require "./platform/os"
 {% end %}
 
 module Gcry
+  # PROBE (not for merge): name an anonymous mapping in /proc/<pid>/smaps.
+  lib LibProbe
+    fun prctl(option : Int32, arg2 : UInt64, arg3 : UInt64, arg4 : UInt64, arg5 : UInt64) : Int32
+  end
+
+  def self.probe_name(ptr : Void*, bytes : UInt64, name : String) : Nil
+    LibProbe.prctl(0x53564d41, 0_u64, ptr.address, bytes, name.to_unsafe.address)
+  end
+
   # A literal, so it is initialised statically: the first `os_map` runs inside
   # `GC.init`, before `once`-guarded initialisers can run (see `mmap_failed?`).
   @@os_mapped_bytes = 0_u64
