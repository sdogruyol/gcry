+    # PROTOTYPE: `Kernels.sweep_words` over interleaved `{occ, mark}` pairs
+    # (`ChunkHeader::BITMAP_STRIDE`), one pair per word of the bitmaps. Plain
+    # Crystal: the SIMD kernels assume two contiguous arrays.
+    private def sweep_words_interleaved(pairs : UInt64*, n : Int32) : {UInt64, UInt64}
+      freed = 0_u64
+      live = 0_u64
+      i = 0
+      while i < n
+        o = pairs[2 * i]
+        m = pairs[2 * i + 1]
+        freed &+= (o & ~m).popcount.to_u64
+        live &+= m.popcount.to_u64
+        pairs[2 * i] = m
+        pairs[2 * i + 1] = 0_u64
+        i += 1
+      end
+      {freed, live}
+    end
