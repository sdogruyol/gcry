+    def dbg_watch_idle_slot(where : String) : Nil
+      cur = Thread.current?
+      cn = cur ? cur.name : nil
+      Thread.unsafe_each do |thread|
+        next unless thread.name == "gc-idle"
+        mf = thread.@main_fiber
+        next unless mf
+        bottom = mf.@stack.bottom.address
+        v = Pointer(UInt64).new(bottom &- 4984).value
+        LibC.dprintf(2, "DBG watch %s collections=%lu collector=%s slot=%#lx value=%#lx parked_sp=%#lx\n",
+          where.to_unsafe, @collections, cn ? cn.to_unsafe : "(nil)".to_unsafe, bottom &- 4984, v, IdleRelease.parked_sp)
+      end
+    end
+
+    @dbg_seed_user = 0_u64
+    @dbg_seed_bytes = 0_u64
+
+    def dbg_after_fiber(fiber : Fiber, top : UInt64, bottom : UInt64, stw_multi : Bool) : Nil
+      user = @dbg_seed_user
+      return if user == 0
+      @dbg_seed_user = 0_u64
+      fin = user &+ @dbg_seed_bytes
+      name = fiber.name
+      LibC.dprintf(2, "DBG big parked seed user=%#lx bytes=%lu fiber=%#lx name=%s running=%d base=%#lx bottom=%#lx stack_top=%#lx scan_top=%#lx scanned=%lu stw_multi=%d own_sp=%#lx\n",
+        user, @dbg_seed_bytes, fiber.object_id, name ? name.to_unsafe : "(nil)".to_unsafe, fiber.running? ? 1 : 0,
+        fiber.@stack.pointer.address, bottom, fiber.@context.stack_top.address, top, bottom &- top, stw_multi ? 1 : 0,
+        Roots.hardware_stack_pointer.address)
+      Thread.unsafe_each do |thread|
+        cf = thread.@current_fiber
+        mf = thread.@main_fiber
+        on = cf && cf == fiber
+        own = mf && mf == fiber
+        sp = other_thread_scan_sp(thread)
+        tn = thread.name
+        LibC.dprintf(2, "DBG   thread=%#lx name=%s current_is=%d main_is=%d sp=%#lx exempt=%d current_fiber=%#lx\n",
+          thread.object_id, tn ? tn.to_unsafe : "(nil)".to_unsafe, on ? 1 : 0, own ? 1 : 0, sp ? sp.address : 0_u64,
+          stw_signal_exempt?(thread) ? 1 : 0, cf ? cf.object_id : 0_u64)
+      end
+      a = top & ~7_u64
+      n = 0
+      while a < bottom && n < 8
+        if Roots.page_readable?(a & ~(Roots::PAGE_SIZE &- 1))
+          v = Pointer(UInt64).new(a).value
+          if v >= user && v < fin
+            LibC.dprintf(2, "DBG   holder slot=%#lx below_bottom=%lu above_stack_top=%ld value=user+%lu\n",
+              a, bottom &- a, (a.to_i64 &- fiber.@context.stack_top.address.to_i64), v &- user)
+            n += 1
+          end
+          a &+= 8
+        else
+          a = (a & ~(Roots::PAGE_SIZE &- 1)) &+ Roots::PAGE_SIZE
+        end
+      end
+    end
+
