+    # Set on a buffered candidate (`scan_batch_prefetched`) taken from a
+    # payload scanned base-only. A word inside the heap span is below 2^48 on
+    # every supported target, so bit 63 is free.
+    CAND_BASE_ONLY = 1_u64 << 63
+
+    @[AlwaysInline]
+    private def resolve_candidates(cand : UInt64*, nc : Int32, shard : MarkShard?,
+                                   l1 : Pointer(Pointer(ChunkHeader*)), shift : Int32, l2_mask : UInt64) : UInt64
+      hits = 0_u64
+      c = 0
+      while c < nc
+        v = cand[c]
+        c += 1
+        hits &+= resolve_candidate(v & ~CAND_BASE_ONLY, (v & CAND_BASE_ONLY) != 0, shard, l1, shift, l2_mask)
+      end
+      hits
+    end
