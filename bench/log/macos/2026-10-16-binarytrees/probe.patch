+        s.value.occ_word.value = s.value.occ_word.value | bit_mask
+      {% else %}
+        Atomic::Ops.atomicrmw(LLVM::AtomicRMWBinOp::Or, s.value.occ_word, bit_mask,
+          LLVM::AtomicOrdering::Monotonic, false)
+      {% end %}
       set.value.bytes_local = local
       set.value.objects_local = set.value.objects_local &+ 1_u64
       if (pfw = @alloc_pfw) > 0
