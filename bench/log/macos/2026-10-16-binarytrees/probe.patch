       s.value.free_mask = mask & (mask &- 1)
-      Atomic::Ops.atomicrmw(LLVM::AtomicRMWBinOp::Or, s.value.occ_word, 1_u64 << bit,
-        LLVM::AtomicOrdering::Monotonic, false)
+      {% if flag?(:gcry_probe_shl) %}
