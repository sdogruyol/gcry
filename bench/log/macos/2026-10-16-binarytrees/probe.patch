diff --git a/src/gcry/bitmap_alloc.cr b/src/gcry/bitmap_alloc.cr
index dcc4104a..39cda746 100644
--- a/src/gcry/bitmap_alloc.cr
+++ b/src/gcry/bitmap_alloc.cr
@@ -11,6 +11,7 @@ lib LibC
   fun pthread_key_create(key : GcryPthreadKeyT*, destructor : Void* -> Void) : Int
   fun pthread_key_delete(key : GcryPthreadKeyT) : Int
   fun pthread_setspecific(key : GcryPthreadKeyT, value : Void*) : Int
+  fun pthread_getspecific(key : GcryPthreadKeyT) : Void*
 end
 {% end %}
 
@@ -240,7 +241,32 @@ module Gcry
 
     @[AlwaysInline]
     protected def cursor_set_cached : CursorSet*
+      {% if flag?(:gcry_probe_getspec) %}
+        # PROBE: the per-heap key's value instead of the Crystal TLS.
+        return Pointer(CursorSet).null unless @cursor_key_ok
+        return Gcry::OS.pthread_getspecific(@cursor_key).as(CursorSet*)
+      {% end %}
+      {% if flag?(:gcry_probe_tsd) && flag?(:darwin) %}
+        # PROBE: what `pthread_getspecific` itself does on Darwin, inline:
+        # the thread's TSD array is at TPIDRRO_EL0 (low 3 bits masked) on
+        # arm64 and at %gs on x86_64, indexed by the key.
+        return Pointer(CursorSet).null unless @cursor_key_ok
+        key = @cursor_key
+        {% if flag?(:aarch64) %}
+          base = 0_u64
+          asm("mrs $0, tpidrro_el0" : "=r"(base) :: : "volatile")
+          return Pointer(Pointer(Void)).new(base & ~7_u64)[key].as(CursorSet*)
+        {% else %}
+          v = 0_u64
+          asm("movq %gs:(,$1,8), $0" : "=r"(v) : "r"(key) : : "volatile")
+          return Pointer(CursorSet).new(v)
+        {% end %}
+      {% end %}
       cached = @@tls_cursor_cache
+      {% if flag?(:gcry_probe_tls2x) %}
+        # PROBE: a second, redundant TLS read, to price one.
+        return Pointer(CursorSet).null unless @@tls_cursor_cache == cached
+      {% end %}
       return Pointer(CursorSet).null unless (cached >> 64) == self.as(Void*).address
       Pointer(CursorSet).new(cached.to_u64!)
     end
