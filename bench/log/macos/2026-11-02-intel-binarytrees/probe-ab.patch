diff --git a/bench/runner_ab/ab.py b/bench/runner_ab/ab.py
index 9e4c427c..08e88a02 100644
--- a/bench/runner_ab/ab.py
+++ b/bench/runner_ab/ab.py
@@ -112,6 +112,7 @@ def run_one(exe, bench, trace, args=None, extra_env=None):
     m = [x for x in LINE.finditer(text) if x.group(1) == bench]
     mark = collections = scanned = None
     per_collection = []
+    gc_sums = {}
     if os.path.exists(trace):
         with open(trace) as f:
             ends = [json.loads(l) for l in f if '"collect_end"' in l]
@@ -121,9 +122,11 @@ def run_one(exe, bench, trace, args=None, extra_env=None):
         # grows scans the sum of its live set at those points, so a change
         # that moves them moves Σ mark without costing anything per byte.
         per_collection = [e.get("scanned_bytes", 0) for e in ends]
+        gc_sums = {k: sum(e.get(k + "_ns", 0) for e in ends) / 1e6 for k in ("pause", "sweep", "flush", "stw_stop", "roots")}
+        gc_sums["majors"] = sum(1 for e in ends if e.get("major"))
     r = dict(rc=rc, wall=wall, peak=peak, utime=utime, stime=stime, faults=faults, mark=mark,
              collections=collections, scanned=scanned, scanned_per_collection=per_collection,
-             time=None, result=None)
+             time=None, result=None, **gc_sums)
     if m:
         r["time"] = float(m[-1].group(4))
         r["result"] = "ok" if m[-1].group(2) == "ok" else m[-1].group(3).strip()
diff --git a/bench/runner_ab/ab.sh b/bench/runner_ab/ab.sh
index 85264f76..7da0ef6c 100755
--- a/bench/runner_ab/ab.sh
+++ b/bench/runner_ab/ab.sh
@@ -142,6 +142,25 @@ if [ "$AB_BENCHES" != - ]; then
     padded build "$psrc" "ab-$pname" -Dgc_none
     arms+=(--arm "$pname=$root/bin/ab-$pname$exe")
   done
+  # AB_REVERTS="name=sha,sha ...": arm rv_<name>, this checkout's source with
+  # those commits reverted (probe only).
+  for spec in ${AB_REVERTS:-}; do
+    rn=${spec%%=*} rshas=${spec#*=}
+    rm -rf "../ab-rv-$rn" && git worktree add -q --detach "../ab-rv-$rn" HEAD
+    # shellcheck disable=SC2086
+    (cd "../ab-rv-$rn" && git -c user.email=ab@probe -c user.name=ab revert --no-commit ${rshas//,/ } && git diff --cached --stat HEAD)
+    build "../ab-rv-$rn" "ab-rv_$rn" -Dgc_none
+    arms+=(--arm "rv_$rn=$root/bin/ab-rv_$rn$exe")
+  done
+  # AB_PATCHES="name=file ...": arm pt_<name>, this checkout's source with
+  # that patch applied (probe only).
+  for spec in ${AB_PATCHES:-}; do
+    rn=${spec%%=*} rpatch=$root/${spec#*=}
+    rm -rf "../ab-pt-$rn" && git worktree add -q --detach "../ab-pt-$rn" HEAD
+    (cd "../ab-pt-$rn" && git apply "$rpatch" && git diff --stat)
+    build "../ab-pt-$rn" "ab-pt_$rn" -Dgc_none
+    arms+=(--arm "pt_$rn=$root/bin/ab-pt_$rn$exe")
+  done
   crystal --version
   # shellcheck disable=SC2086 # AB_BENCHES is a space-separated list
   "$py" bench/runner_ab/ab.py --out "$out" --reps "${AB_REPS:-10}" "${arms[@]}" $AB_BENCHES
