@@ -74,6 +82,12 @@ module Gcry
         @hl_stack_seed_dump = 0
       end
     {% end %}
+    {% if flag?(:gcry_hold_probe) %}
+      @[NoInline]
+      def self.hold_probe_stop(slot : UInt64) : Nil
+        asm("" :: "r"(slot) : "memory")
+      end
+    {% end %}
 
     # add_root / collect(roots:) / realloc pin — never type_id_gate (raw Hash
     # @entries / Array @buffer have no Crystal type_id). Interior policy matches
@@ -232,6 +246,15 @@ module Gcry
       end
 
       set_block_mark_in(chunk, header)
+      {% if flag?(:gcry_hold_probe) %}
+        if ChunkHeader.large?(chunk) && block_payload(chunk, header) >= 32_u64 * 1024 * 1024
+          slot = Roots.hl_slot
+          LibC.printf("HOLDPROBE coll=%llu src=%d cand=%p user=%p size=%llu slot=%p slot-entry=%lld bottom-slot=%lld\n",
+            @collections, source.value, pointer, user_of(chunk, header), block_payload(chunk, header),
+            Pointer(Void).new(slot), slot.to_i64 - @collect_entry_sp.to_i64, @stack_bottom.address.to_i64 - slot.to_i64)
+          Heap.hold_probe_stop(slot) unless source == RootSource::Heap
+        end
+      {% end %}
       note_first_mark(chunk, header, source) if @live_attr_roots
       # Atomic payloads have no edges. The chunk is already resolved here;
       # preserve its mark and attribution without a queue round trip.
