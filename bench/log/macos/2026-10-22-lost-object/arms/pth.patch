+        grown = LibC.realloc(@@stop_entries.as(Void*), LibC::SizeT.new(cap) * sizeof(StopEntry))
+        raise "gcry: cannot size the Darwin stop table for #{cap} threads" if grown.null?
+        @@stop_entries = grown.as(Pointer(StopEntry))
+        @@stop_capacity = cap
+      end
