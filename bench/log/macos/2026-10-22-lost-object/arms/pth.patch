+          end
+          i += 1
+        end
+        @@stop_bounds_misses &+= 1
+        nil
+      end
+
+      def self.stop_active? : Bool
+        @@stop_active
+      end
+
+      def self.stop_bounds_misses : UInt64
+        @@stop_bounds_misses
+      end
